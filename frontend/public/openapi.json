  "components": {
    "schemas": {
      "CalculationRequest": {
        "properties": {
          "grade": {
            "type": "string",
            "title": "Grade",
            "description": "JSL grade ID (e.g. J304, J4, J430, J2205)",
            "default": "J304"
          },
          "scrap_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Scrap Pct",
            "description": "% recycled stainless scrap",
            "default": 60.0
          },
          "facility": {
            "type": "string",
            "title": "Facility",
            "description": "Facility profile ('jajpur' or 'hisar')",
            "default": "jajpur"
          },
          "fe_source": {
            "type": "string",
            "title": "Fe Source",
            "description": "'coalDRI', 'gasDRI', or 'pigIron'",
            "default": "coalDRI"
          },
          "fecr_source": {
            "type": "string",
            "title": "Fecr Source",
            "description": "'fecrStandard' (HC) or 'fecrLowC' (LC)",
            "default": "fecrStandard"
          },
          "ni_source": {
            "type": "string",
            "title": "Ni Source",
            "description": "'niStandard', 'niClass1' (Hydro), or 'niNPI' (Indonesian coal RKEF)",
            "default": "niStandard"
          },
          "recovery": {
            "type": "string",
            "title": "Recovery",
            "description": "'standard' (92% Cr) or 'optimised' (96% Cr)",
            "default": "standard"
          },
          "product": {
            "type": "string",
            "title": "Product",
            "description": "Finished product (crCoil, hrCoil, slab, plate, specialty, rebar, wireRod)",
            "default": "crCoil"
          },
          "casting": {
            "type": "string",
            "title": "Casting",
            "description": "'continuous' or 'ingot'",
            "default": "continuous"
          },
          "refining": {
            "type": "string",
            "title": "Refining",
            "description": "'aod' or 'aodvod'",
            "default": "aod"
          },
          "renewable_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Renewable Pct",
            "description": "% renewable power PPA share",
            "default": 47.0
          },
          "hot_fecr_charging": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hot Fecr Charging",
            "description": "Hot molten FeCr sensible heat charging (auto if Jajpur)"
          },
          "ideal_yield": {
            "type": "boolean",
            "title": "Ideal Yield",
            "description": "If True, bypass downstream finishing yield loss",
            "default": false
          },
          "eu_ets_price_eur": {
            "type": "number",
            "minimum": 0.0,
            "title": "Eu Ets Price Eur",
            "description": "EU ETS carbon allowance price (\u20ac/tCO2)",
            "default": 80.0
          },
          "india_ccc_price_inr": {
            "type": "number",
            "minimum": 0.0,
            "title": "India Ccc Price Inr",
            "description": "India CCTS Carbon Credit Certificate price (\u20b9/tCO2)",
            "default": 1500.0
          }
        },
        "type": "object",
        "title": "CalculationRequest"
      },
      "ExplainRequest": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target",
            "description": "total_co2_t, eaf_sec_kwh, cbam_tariff_eur, ccts_value_inr",
            "default": "total_co2_t"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "Optional conversational question"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params",
            "description": "Cockpit calculation parameters"
          }
        },
        "type": "object",
        "title": "ExplainRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MonteCarloRequest": {
        "properties": {
          "grade": {
            "type": "string",
            "title": "Grade",
            "description": "Target stainless grade",
            "default": "J304"
          },
          "runs": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 10.0,
            "title": "Runs",
            "description": "Number of Monte Carlo heats",
            "default": 1000
          },
          "alpha_cost_weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Alpha Cost Weight",
            "description": "Cost vs Carbon weight",
            "default": 0.5
          },
          "std_dev_cr": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Std Dev Cr",
            "default": 0.8
          },
          "std_dev_ni": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Std Dev Ni",
            "default": 0.4
          },
          "std_dev_cu": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Std Dev Cu",
            "default": 0.04
          },
          "std_dev_sn": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 0.0,
            "title": "Std Dev Sn",
            "default": 0.003
          },
          "facility": {
            "type": "string",
            "title": "Facility",
            "description": "Facility profile",
            "default": "jajpur"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed for reproducibility"
          }
        },
        "type": "object",
        "title": "MonteCarloRequest"
      },
      "MonteCarloResponse": {
        "properties": {
          "grade_id": {
            "type": "string",
            "title": "Grade Id"
          },
          "runs": {
            "type": "integer",
            "title": "Runs"
          },
          "p10_cost_usd_per_t": {
            "type": "number",
            "title": "P10 Cost Usd Per T"
          },
          "p50_cost_usd_per_t": {
            "type": "number",
            "title": "P50 Cost Usd Per T"
          },
          "p90_cost_usd_per_t": {
            "type": "number",
            "title": "P90 Cost Usd Per T"
          },
          "p10_co2_t_per_t": {
            "type": "number",
            "title": "P10 Co2 T Per T"
          },
          "p50_co2_t_per_t": {
            "type": "number",
            "title": "P50 Co2 T Per T"
          },
          "p90_co2_t_per_t": {
            "type": "number",
            "title": "P90 Co2 T Per T"
          },
          "compliance_probability_pct": {
            "type": "number",
            "title": "Compliance Probability Pct"
          },
          "compliant_runs": {
            "type": "integer",
            "title": "Compliant Runs"
          }
        },
        "type": "object",
        "required": [
          "grade_id",
          "runs",
          "p10_cost_usd_per_t",
          "p50_cost_usd_per_t",
          "p90_cost_usd_per_t",
          "p10_co2_t_per_t",
          "p50_co2_t_per_t",
          "p90_co2_t_per_t",
          "compliance_probability_pct",
          "compliant_runs"
        ],
        "title": "MonteCarloResponse"
      },
      "OptimizationRequest": {
        "properties": {
          "grade": {
            "type": "string",
            "title": "Grade",
            "description": "Target stainless grade",
            "default": "J304"
          },
          "alpha_cost_weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Alpha Cost Weight",
            "description": "1.0 = Least Cost, 0.0 = Least Carbon",
            "default": 0.5
          },
          "facility": {
            "type": "string",
            "title": "Facility",
            "description": "Facility profile ('jajpur' or 'hisar')",
            "default": "jajpur"
          },
          "allow_npi": {
            "type": "boolean",
            "title": "Allow Npi",
            "description": "Allow Indonesian Coal RKEF NPI",
            "default": true
          },
          "allow_gas_dri": {
            "type": "boolean",
            "title": "Allow Gas Dri",
            "description": "Allow Gas-based DRI",
            "default": true
          },
          "allow_pig_iron": {
            "type": "boolean",
            "title": "Allow Pig Iron",
            "description": "Allow Blast Furnace Pig Iron",
            "default": true
          },
          "enforce_scrap_cap": {
            "type": "boolean",
            "title": "Enforce Scrap Cap",
            "description": "Enforce grade-specific tramp scrap cap",
            "default": true
          },
          "custom_scrap_cap": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Scrap Cap",
            "description": "Override scrap cap %"
          },
          "electricity_cost_usd_kwh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Electricity Cost Usd Kwh",
            "description": "Optional electricity tariff override in USD/kWh"
          }
        },
        "type": "object",
        "title": "OptimizationRequest"
      },
      "ParetoRequest": {
        "properties": {
          "grade": {
            "type": "string",
            "title": "Grade",
            "description": "Target stainless grade",
            "default": "J304"
          },
          "steps": {
            "type": "integer",
            "maximum": 51.0,
            "minimum": 3.0,
            "title": "Steps",
            "description": "Number of alpha evaluation steps",
            "default": 11
          },
          "facility": {
            "type": "string",
            "title": "Facility",
            "description": "Facility profile",
            "default": "jajpur"
          }
        },
        "type": "object",
        "title": "ParetoRequest"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Conversational question from user"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params",
            "description": "Cockpit calculation parameters"
          },
          "tool_call": {
            "anyOf": [
              {
